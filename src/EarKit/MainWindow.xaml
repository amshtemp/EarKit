<ui:FluentWindow x:Class="EarKit.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="EarKit" Width="1100" Height="760" MinWidth="920" MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
                 FontFamily="{StaticResource AppFont}"
                 Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="AppTitleBar" Title="EarKit">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left navigation -->
            <DockPanel Grid.Column="0" Margin="4,4,0,8">
                <Border DockPanel.Dock="Bottom" Margin="10,8,10,4" Padding="12,10" CornerRadius="8"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="NavDot" Width="8" Height="8" Fill="Gray" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="NavStatus" Text="Not connected" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="NavBattery" Text="" FontSize="12" Margin="16,4,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
                <ListBox x:Name="Nav" Style="{StaticResource NavList}" SelectionChanged="Nav_SelectionChanged" />
            </DockPanel>

            <!-- Main content -->
            <Grid Grid.Column="1" Margin="8,4,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Connection bar -->
                <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="ConnIcon" Grid.Column="0" Symbol="Bluetooth24" FontSize="22" Margin="4,0,12,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="DeviceBox" Grid.Column="1" MinWidth="260" VerticalAlignment="Center" />
                        <ui:Button x:Name="RefreshBtn" Grid.Column="2" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="Refresh device list"
                                   Click="Refresh_Click" VerticalAlignment="Stretch" />
                        <ui:Button x:Name="ConnectBtn" Grid.Column="3" Margin="8,0,0,0" MinWidth="104" Appearance="Primary"
                                   Icon="{ui:SymbolIcon PlugConnected24}" Content="Connect" Click="Connect_Click" VerticalAlignment="Stretch" />
                        <ui:ProgressRing x:Name="Busy" Grid.Column="4" Width="22" Height="22" Margin="12,0,4,0" IsIndeterminate="True" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" x:Name="Notices" Margin="0,8,0,0" />

                <ScrollViewer Grid.Row="2" x:Name="Scroller" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <ContentControl x:Name="PageHost" Margin="4,8,4,8" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
